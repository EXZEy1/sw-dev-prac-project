{
  "info": {
    "name": "Dentist Booking - P0 starter checks",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Checks auth, readiness and route role guards. Admin access may return 200 when implemented or explicit 501 during handoff. Use admin-core and queue-waitlist collections to verify B features."
  },
  "item": [
    {
      "name": "P0 Health and database readiness",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{serverUrl}}/health",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('P0 database ready', () => pm.expect(pm.response.json().database).to.equal('ready')); "
            ]
          }
        }
      ]
    },
    {
      "name": "P0 Admin login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": "{{baseUrl}}/auth/login",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"{{adminEmail}}\", \"password\": \"{{demoPassword}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) pm.environment.set('adminToken', pm.response.json().token);",
              "pm.test('Token returned at top level', () => pm.expect(pm.response.json().token).to.be.a('string'));",
              "pm.test('Password omitted', () => pm.expect(pm.response.json()).not.to.have.property('password')); "
            ]
          }
        }
      ]
    },
    {
      "name": "P0 Admin identity",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}",
            "type": "text"
          }
        ],
        "url": "{{baseUrl}}/auth/me",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Admin role from database', () => pm.expect(pm.response.json().data.role).to.equal('admin')); "
            ]
          }
        }
      ]
    },
    {
      "name": "P0 User login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": "{{baseUrl}}/auth/login",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"{{extraUserEmail}}\", \"password\": \"{{demoPassword}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) pm.environment.set('userToken', pm.response.json().token);",
              "pm.test('Token returned at top level', () => pm.expect(pm.response.json().token).to.be.a('string'));",
              "pm.test('Password omitted', () => pm.expect(pm.response.json()).not.to.have.property('password')); "
            ]
          }
        }
      ]
    },
    {
      "name": "P0 User identity",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{userToken}}",
            "type": "text"
          }
        ],
        "url": "{{baseUrl}}/auth/me",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Registered user and telephone', () => { const u=pm.response.json().data; pm.expect(u.role).to.equal('user'); pm.expect(u.tel).to.be.a('string'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "P0 User denied admin route",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{userToken}}",
            "type": "text"
          }
        ],
        "url": "{{baseUrl}}/admin/appointments",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 403', () => pm.response.to.have.status(403));"
            ]
          }
        }
      ]
    },
    {
      "name": "P0 Admin role guard - feature demo is separate",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}",
            "type": "text"
          }
        ],
        "url": "{{baseUrl}}/admin/appointments",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Admin passes the role guard', () => pm.expect(pm.response.code).to.be.oneOf([200, 501]));",
              "pm.test('Explicit response for the current phase', () => { if (pm.response.code === 501) pm.expect(pm.response.json().code).to.equal('FEATURE_NOT_IMPLEMENTED'); else { pm.expect(pm.response.json().success).to.equal(true); pm.expect(pm.response.json().data).to.be.an('array'); } });"
            ]
          }
        }
      ]
    },
    {
      "name": "P0 Logout and clear client token",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{userToken}}",
            "type": "text"
          }
        ],
        "url": "{{baseUrl}}/auth/logout",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.environment.unset('userToken');"
            ]
          }
        }
      ]
    },
    {
      "name": "P0 Anonymous request denied after logout",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/auth/me",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 401', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const today = new Date(Date.now() + 7 * 60 * 60 * 1000).toISOString().slice(0, 10);",
          "const plus = n => { const d = new Date(today + 'T12:00:00Z'); d.setUTCDate(d.getUTCDate() + n); return d.toISOString().slice(0, 10); };",
          "pm.environment.set('bookingDate', plus(7));",
          "pm.environment.set('changedBookingDate', plus(8));",
          "pm.environment.set('extraBookingDate', today);"
        ]
      }
    }
  ]
}
