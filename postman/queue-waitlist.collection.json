{
  "info": {
    "name": "Dentist Booking - B queue and waiting list TODO",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "B owns this collection. Expected 201/200 responses deliberately fail on P0 placeholders. Run after A questionnaire/QR demo and after a fresh seed."
  },
  "item": [
    {
      "name": "Extra Admin login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": "{{baseUrl}}/auth/login",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"{{adminEmail}}\", \"password\": \"{{demoPassword}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) pm.environment.set('adminToken', pm.response.json().token);",
              "pm.test('Token returned at top level', () => pm.expect(pm.response.json().token).to.be.a('string'));",
              "pm.test('Password omitted', () => pm.expect(pm.response.json()).not.to.have.property('password')); "
            ]
          }
        }
      ]
    },
