    {
      "name": "12 Admin cancel target booking",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}",
            "type": "text"
          }
        ],
        "url": "{{baseUrl}}/admin/appointments/{{adminAppointmentId}}",
        "auth": {
          "type": "noauth"
        }
