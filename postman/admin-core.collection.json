          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "(() => {",
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const data = pm.response.json().data;",
              "pm.test('Cancellation payload', () => { pm.expect(data.appointmentId).to.equal(pm.environment.get('adminAppointmentId')); pm.expect(data.dentistId).to.equal(pm.environment.get('dentistId')); pm.expect(data.bookingDate).to.equal(pm.environment.get('changedBookingDate')); pm.expect(Date.parse(data.cancelledAt)).to.be.a('number').and.not.NaN; });",
              "if (pm.response.code === 200) pm.environment.set('adminCancelledAt', data.cancelledAt);",
              "})();"
            ]
          }
        }
