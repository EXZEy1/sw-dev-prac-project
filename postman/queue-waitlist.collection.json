              "const rows = pm.response.json().data;",
              "pm.test('Two arrivals in order', () => { pm.expect(rows.length).to.equal(2); pm.expect(rows[0].appointment).to.equal(pm.environment.get('extraAppointmentId')); pm.expect(rows[1].appointment).to.equal(pm.environment.get('queueAppointmentId')); });",
