    {
      "name": "10 Admin view any bookings",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}",
            "type": "text"
          }
        ],
        "url": "{{baseUrl}}/admin/appointments",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "(() => {",
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('Count matches data', () => pm.expect(body.count).to.equal(body.data.length));",
              "pm.test('Only booked appointments by default', () => body.data.forEach((row) => pm.expect(row.status).to.equal('booked')));",
              "pm.test('Includes bookings of other users', () => pm.expect(body.data.map((row) => row._id)).to.include(pm.environment.get('adminAppointmentId')));",
              "})();"
            ]
          }
        }
      ]
    },
