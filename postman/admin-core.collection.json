{
  "info": {
    "name": "Dentist Booking - 09-12 Admin Core",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "B: admin views, edits and cancels any booking. Run after a fresh seed:demo."
  },
  "item": [
    {
      "name": "09 Admin login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": "{{baseUrl}}/auth/login",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"{{adminEmail}}\", \"password\": \"{{demoPassword}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "(() => {",
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const data = pm.response.json();",
              "pm.test('Token returned at top level', () => pm.expect(data.token).to.be.a('string'));",
              "pm.test('Password omitted', () => pm.expect(data).not.to.have.property('password'));",
              "if (pm.response.code === 200) pm.environment.set('adminToken', data.token);",
              "})();"
            ]
          }
        }
      ]
    },
    {
      "name": "09 Admin role confirmed",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}",
            "type": "text"
