NODE_ENV=development
HOST=127.0.0.1
PORT=5003
MONGO_URI=mongodb://127.0.0.1:27019/dentist_booking_demo
JWT_SECRET=
JWT_EXPIRE=1d
DEMO_PASSWORD=
# npm run setup:local generates local values without printing them.
# MongoDB Atlas: keep the database name dentist_booking_demo so seed:demo accepts it.
# MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/dentist_booking_demo?retryWrites=true&w=majority
# Optional: full path to an existing mongod executable for db:demo/tests.
# MONGOMS_SYSTEM_BINARY=C:/path/to/mongod.exe
