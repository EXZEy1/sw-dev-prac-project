      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "(() => {",
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "const data = pm.response.json().data;",
              "pm.test('Entry starts waiting', () => { pm.expect(data.status).to.equal('waiting'); pm.expect(data.appointment).to.equal(pm.environment.get('extraAppointmentId')); });",
              "pm.test('Server recorded arrival time', () => pm.expect(Date.parse(data.arrivedAt)).to.be.a('number').and.not.NaN);",
              "if (pm.response.code === 201) { pm.environment.set('queueEntryId', data._id); pm.environment.set('firstArrivedAt', data.arrivedAt); }",
              "})();"
            ]
          }
        }
      ]
    },
